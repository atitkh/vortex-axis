{
  "name": "vortex-axis",
  "version": "0.23.0",
  "private": true,
  "description": "Hub between thin client devices and an AI agent: made for OpenClaw, usable with any harness through MCP",
  "workspaces": [
    "protocol",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build --workspace protocol",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run build --workspace protocol",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node server/dist/index.js",
    "browser-check": "npm run build && node scripts/browser-check.mjs",
    "latency-probe": "node scripts/latency-probe.mjs",
    "push-firmware": "node scripts/push-firmware.mjs",
    "deploy": "AXIS_COMMIT=$(git rev-parse --short HEAD) docker compose up -d --build"
  },
  "engines": {
    "node": ">=24"
  }
}
