{
  "name": "vortex-axis",
  "private": true,
  "description": "Hub between thin client devices and an OpenClaw agent",
  "workspaces": [
    "protocol",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build --workspace protocol",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run build --workspace protocol",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node server/dist/index.js",
    "browser-check": "npm run build && node scripts/browser-check.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
