# Copy to .env and fill in. Never commit .env.
#
# Only AXIS_ADMIN_TOKEN has to be set here. The speech, agent and gateway values
# below are starting points: anything saved on the admin page is stored in the
# data volume and wins over this file from then on.

# Bearer token for the admin API. The admin API is disabled when this is empty.
# Generate one with: openssl rand -base64 32
AXIS_ADMIN_TOKEN=

# Port published on the host.
AXIS_PORT=8440

# Subnet of the container's network. If the gateway runs on the Docker host
# behind a firewall, allow this range to reach the gateway's port, for example:
#   sudo ufw allow from 10.84.40.0/24 to any port 18789 proto tcp
# AXIS_SUBNET=10.84.40.0/24

# How long a pairing code stays valid, in milliseconds.
# AXIS_PAIRING_CODE_TTL_MS=600000

# --- Speech services (OpenAI-style HTTP endpoints) -------------------------
# Speech recognition. Leave empty to run without it.
AXIS_STT_URL=http://stt-host:8000/v1/audio/transcriptions
AXIS_STT_MODEL=whisper-1
# AXIS_STT_API_KEY=

# Speech synthesis. Axis asks for raw PCM and needs to know its sample rate.
AXIS_TTS_URL=http://tts-host:8000/v1/audio/speech
AXIS_TTS_MODEL=tts-1
AXIS_TTS_SAMPLE_RATE=24000
# Default voice. A "voice" setting on a client, type or globally overrides it.
# AXIS_TTS_VOICE=
# AXIS_TTS_API_KEY=

# --- OpenClaw gateway ----------------------------------------------------------
# Axis joins the gateway over its WebSocket, as one device holding an operator
# link (turns go to an agent) and a node link (agents call Axis's commands).
# Pairing is done at runtime with a setup code, not here. See the README.

# Gateway address. Optional: when empty, the address inside the setup code is used.
AXIS_GATEWAY_URL=ws://host.docker.internal:18789
# Agent that answers. When empty, the gateway's default agent.
AXIS_AGENT_ID=
# All clients share one conversation under this key.
AXIS_AGENT_SESSION_KEY=vortex-axis
# Name the hub shows up under on the gateway.
# AXIS_NODE_NAME=VorteX Axis

# --- Another agent instead of OpenClaw (optional) --------------------------------
# Any OpenAI-style streaming chat endpoint. Setting this makes it the one that
# answers turns. The gateway link still runs if it is paired.
# AXIS_AGENT_URL=http://model-host:11434/v1/chat/completions
# AXIS_AGENT_MODEL=
# AXIS_AGENT_TOKEN=

# --- Tuning ------------------------------------------------------------------
# How long wake arbitration waits for other clients, in milliseconds.
# AXIS_WAKE_WINDOW_MS=200
# Longest utterance accepted, in milliseconds.
# AXIS_MAX_UTTERANCE_MS=30000
# How often upstream services are checked, in milliseconds. 0 turns it off.
# AXIS_HEALTH_INTERVAL_MS=30000
# How long the last client spoken to stays the default place for the agent to
# speak, in milliseconds.
# AXIS_OUTPUT_HOLD_MS=600000
