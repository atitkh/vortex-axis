# Copy to .env and fill in. Never commit .env.
#
# Only AXIS_ADMIN_TOKEN has to be set here. The speech, agent and gateway values
# below are starting points: anything saved on the admin page is stored in the
# data folder and wins over this file from then on.

# Bearer token for the admin API: 24 characters or more. The admin API is disabled when
# this is empty or shorter.
# Generate one with: openssl rand -base64 32
AXIS_ADMIN_TOKEN=

# Port published on the host.
AXIS_PORT=8440

# Folder on the host that holds Axis's data. Defaults to ./data next to the
# compose file. Create it first (mkdir) so it is owned by you, not by root.
# AXIS_DATA_PATH=./data

# Folder on the host where Axis copies its data (database, firmware, wake
# words) by itself, every hour unless changed on the admin page's Integrations
# section. Put it on another disk than the data folder, and create it first so
# it is owned by you. Leave unset for no backup.
# AXIS_BACKUP_PATH=/mnt/storage/vortex-axis-backup

# Subnet of the container's network. If the gateway runs on the Docker host
# behind a firewall, allow this range to reach the gateway's port, for example:
#   sudo ufw allow from 10.84.40.0/24 to any port 18789 proto tcp
# AXIS_SUBNET=10.84.40.0/24

# How long a pairing code stays valid, in milliseconds.
# AXIS_PAIRING_CODE_TTL_MS=600000

# --- Speech services (OpenAI-style HTTP endpoints) -------------------------
# compose.yaml runs local ones beside Axis (speech recognition, speech
# synthesis and voiceprints, on the CPU). The addresses below use them; point
# them anywhere else that speaks OpenAI's audio API instead if you like.
# The folder the speech services keep their models in (about 250 MB, fetched
# on first start). Create it first so it is owned by you.
# AXIS_MODELS_PATH=/srv/vortex-axis-models
# CPU threads for each of recognition and synthesis.
# AXIS_SPEECH_THREADS=2

# Speech recognition. Leave empty to run without it.
AXIS_STT_URL=http://vortex-axis-stt:8000/v1/audio/transcriptions
AXIS_STT_MODEL=whisper-1
# AXIS_STT_API_KEY=

# Speech synthesis. Axis asks for raw PCM and needs to know its sample rate.
AXIS_TTS_URL=http://vortex-axis-tts:8000/v1/audio/speech
AXIS_TTS_MODEL=tts-1
AXIS_TTS_SAMPLE_RATE=24000
# Default voice. A "voice" setting on a client, type or globally overrides it.
# AXIS_TTS_VOICE=
# AXIS_TTS_API_KEY=

# Voiceprints, for telling the owner's voice from a guest's (off until switched
# on in the admin page). compose.yaml sets this to its own service.
# AXIS_VOICEPRINT_URL=http://vortex-axis-voiceprint:8000/v1/speaker/embed

# --- OpenClaw gateway ----------------------------------------------------------
# Axis joins the gateway over its WebSocket, as one device holding an operator
# link (turns go to an agent) and a node link (agents call Axis's commands).
# Pairing is done at runtime with a setup code, not here. See the README.

# Gateway address. Optional: when empty, the address inside the setup code is used.
AXIS_GATEWAY_URL=ws://host.docker.internal:18789
# Agent that answers. When empty, the gateway's default agent.
AXIS_AGENT_ID=
# All clients share one conversation under this key.
AXIS_AGENT_SESSION_KEY=vortex-axis
# Name the hub shows up under on the gateway.
# AXIS_NODE_NAME=VorteX Axis

# --- Another agent instead of OpenClaw (optional) --------------------------------
# Any OpenAI-style streaming chat endpoint. Setting this makes it the one that
# answers turns. The gateway link still runs if it is paired.
# AXIS_AGENT_URL=http://model-host:11434/v1/chat/completions
# AXIS_AGENT_MODEL=
# AXIS_AGENT_TOKEN=

# --- Tuning ------------------------------------------------------------------
# How long wake arbitration waits for other clients, in milliseconds.
# AXIS_WAKE_WINDOW_MS=200
# How far below the best wake score (0 to 0.5) a louder device may be and still answer; 0 = best score only.
# A value saved on the admin page's Wake words page wins over this.
# AXIS_WAKE_MARGIN=0.1
# Battery percent at or below which a device on the "auto" profile goes to power saver while not charging; 0 = never.
# A value saved on the admin page's Integrations page wins over this.
# AXIS_POWER_SAVER_BELOW=20
# Charge limit (50 to 100 %) a device on the Dock profile holds its battery at while on USB.
# A value saved on the admin page's System page wins over this.
# AXIS_DOCK_CHARGE_LIMIT=80
# The most a board's charger draws, in mA (100 to 1000), for every board; the board tapers it as the battery fills.
# 1000 is 1C for a 1000 mAh cell. A value saved on the admin page's System page wins over this.
# AXIS_CHARGE_CURRENT=1000
# Longest utterance accepted, in milliseconds.
# AXIS_MAX_UTTERANCE_MS=30000
# How often upstream services are checked, in milliseconds. 0 turns it off.
# AXIS_HEALTH_INTERVAL_MS=30000
# How often each client is pinged, in milliseconds. A device that stops answering
# (lost power or Wi-Fi) is shown offline within two of these. 0 turns it off.
# AXIS_PING_INTERVAL_MS=15000
# How many days of turn timings and events the admin page keeps for its
# activity and uptime views. What was said is never stored.
# AXIS_ACTIVITY_DAYS=7
# How long the last client spoken to stays the default place for the agent to
# speak, in milliseconds.
# AXIS_OUTPUT_HOLD_MS=600000

# How long something said to a client that is offline is kept, to be said when
# it comes back. Milliseconds.
# AXIS_MESSAGE_HOLD_MS=600000
# How long the agent may say nothing new before a device stops waiting and the run carries on in the background (ms, 0: never).
# AXIS_HANDOVER_MS=45000

# Tasks and timers as live activities on phones, through Home Assistant (needs the
# MQTT link and the blueprint; also a switch on the Integrations page).
# AXIS_LIVE_ACTIVITIES=1

# The time zone quiet hours ("Quiet from", "Quiet until") are told in. The
# container runs on UTC, so set this to where the devices are.
# AXIS_TIMEZONE=America/Chicago

# --- Reaching Axis from outside ---------------------------------------------
# Host names Axis is reached by through a reverse proxy on a public domain.
# Requests for these names get the client side only (the web client, pairing,
# the client socket, firmware downloads). The admin page and API answer "not
# found" there and stay on the local network. Comma separated.
# AXIS_PUBLIC_HOSTS=axis.example.org
# The address the reverse proxy connects from, so Axis can tell visitors apart
# (attempt limits) by the X-Forwarded-For it adds. Comma separated.
# AXIS_TRUSTED_PROXIES=192.168.1.10

# Home Assistant. Give the address of the MQTT broker Home Assistant uses and
# every client appears there as a device (state, online, a "say" notify entity,
# volume), with the hub itself offering "say everywhere". Needs Home
# Assistant's MQTT integration with discovery on, which is its default.
# AXIS_MQTT_URL=mqtt://user:password@host.docker.internal:1883
# AXIS_HA_DISCOVERY_PREFIX=homeassistant
