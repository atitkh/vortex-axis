<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No window, no service, no permission: it only answers the VorteX Axis app (checked by uid) while the shell
         user keeps it running with `am instrument -w`. Its target is itself, so starting it stops nothing else. -->
    <!-- The only app it answers: its uid and signing key are checked. -->
    <queries>
        <package android:name="dev.vortexaxis.quest" />
    </queries>
    <application android:label="VorteX Axis helper" android:allowBackup="false" android:hasCode="true" />
    <instrumentation
        android:name=".Helper"
        android:targetPackage="dev.vortexaxis.quest.helper"
        android:label="VorteX Axis fast engine" />
</manifest>
