<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No window and no service. INTERNET only because Android refuses any socket to a package without it, even one
         bound to 127.0.0.1: the helper listens there for the VorteX Axis app and answers it alone (an app that proves
         it holds the secret it was started with). Its target is itself, so starting it stops nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The only app it answers: its uid and signing key are checked. -->
    <queries>
        <package android:name="dev.vortexaxis.quest" />
    </queries>
    <application android:label="VorteX Axis helper" android:allowBackup="false" android:hasCode="true" />
    <instrumentation
        android:name=".Helper"
        android:targetPackage="dev.vortexaxis.quest.helper"
        android:label="VorteX Axis fast engine" />
</manifest>
