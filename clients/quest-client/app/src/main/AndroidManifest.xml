<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- To list the apps an agent may open by name (package visibility, Android 11 and later). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Cleartext: Axis on the local network is usually plain http (http://192.168.1.20:8440). -->
    <application
        android:label="VorteX Axis"
        android:icon="@drawable/ic_axis"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Axis">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s|questpro|quest2" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".AxisService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
