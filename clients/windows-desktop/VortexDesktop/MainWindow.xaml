<Window x:Class="Axis.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VorteX Axis" Width="420" Height="600" MinWidth="380" MinHeight="520"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name, and how it stands. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="logo.png" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="VorteX Axis" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Desktop · experimental" Style="{StaticResource Help}" Margin="0,1,0,0" />
            </StackPanel>
            <Border x:Name="Pill" Grid.Column="2" CornerRadius="999" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="PillText" Text="Not paired" FontSize="12" Foreground="{StaticResource Dim}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Not paired yet. -->
        <StackPanel x:Name="PairPanel" Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Connect this computer to Axis so agents can see what's on the screen, point at things, and click and type when you ask. It never types passwords." Style="{StaticResource Help}" />
            <TextBlock Text="Axis address" Style="{StaticResource Label}" />
            <TextBox x:Name="AddressBox" ToolTip="For example 192.168.1.20:8440, or a setup string axis://…" />
            <TextBlock Text="Pairing code" Style="{StaticResource Label}" />
            <TextBox x:Name="CodeBox" ToolTip="From Axis's admin page: Add a device" />
            <TextBlock Text="This computer's name" Style="{StaticResource Label}" />
            <TextBox x:Name="NameBox" />
            <Button x:Name="PairButton" Content="Pair" Style="{StaticResource Primary}" Margin="0,20,0,0" HorizontalAlignment="Left" Click="OnPair" />
            <TextBlock x:Name="PairError" Foreground="{StaticResource Bad}" Style="{StaticResource Help}" Margin="0,12,0,0" />
            <TextBlock Text="Get a code on Axis's admin page under Add a device. A setup string (axis://…) pasted as the address fills in the code too." Style="{StaticResource Help}" Margin="0,14,0,0" />
        </StackPanel>

        <!-- Paired. -->
        <Grid x:Name="PairedPanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="WhereText" Style="{StaticResource Help}" />
                <TextBlock x:Name="StatusDetail" Style="{StaticResource Help}" Foreground="{StaticResource Warn}" Margin="0,4,0,0" />
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" />
                <CheckBox x:Name="AllowSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="OnAllow">
                    <StackPanel>
                        <TextBlock Text="Let agents see, point, click and type" />
                        <TextBlock Text="Off pauses everything. Ctrl+Alt+S toggles it from anywhere." Style="{StaticResource Help}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="StartSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="OnStartWithWindows">
                    <TextBlock Text="Start with Windows" />
                </CheckBox>
                <Button Content="Show the pointer" Margin="0,18,0,0" HorizontalAlignment="Left" Click="OnShowPointer" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Recently" Style="{StaticResource Label}" Margin="0,22,0,6" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Style="{StaticResource Help}" Foreground="{StaticResource Faint}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Help}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="NothingYet" Grid.Row="2" Text="Nothing yet. What agents look at and point to shows here." Style="{StaticResource Help}" Foreground="{StaticResource Faint}" />
            <Button Grid.Row="3" Content="Forget this pairing" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnForget" />
        </Grid>

        <TextBlock x:Name="Footer" Grid.Row="2" Style="{StaticResource Help}" Foreground="{StaticResource Faint}" Margin="0,12,0,0" />
    </Grid>
</Window>
