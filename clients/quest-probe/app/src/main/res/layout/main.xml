<?xml version="1.0" encoding="utf-8"?>
<!-- One scroll for the whole panel: controls on top, log underneath. Big text and
     buttons so it stays legible on a Quest 2D panel. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:id="@+id/scroll">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold" android:paddingBottom="12dp"
            android:text="disconnected" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/connect" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="Connect (auth)" />
            <Button android:id="@+id/disconnect" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="Disconnect" />
            <Button android:id="@+id/forget" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="Forget key" />
        </LinearLayout>

        <Button android:id="@+id/run" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Run adb handshake (Q1)" />

        <CheckBox android:id="@+id/allowActions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:text="Allow actions (taps, swipes, text, am/pm/settings...)" />

        <Button android:id="@+id/runAll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Run all read-only checks" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Read-only checks" android:textStyle="bold" android:paddingTop="12dp" android:textSize="16sp" />

        <Button android:id="@+id/cId" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="whoami / id" />
        <Button android:id="@+id/cDump" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dump active panel" />
        <Button android:id="@+id/cWindows" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="List windows" />
        <Button android:id="@+id/cDisplays" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="List displays" />
        <Button android:id="@+id/cForeground" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Foreground app" />
        <Button android:id="@+id/cScreencap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Screenshot size" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Actions (need checkbox)" android:textStyle="bold" android:paddingTop="12dp" android:textSize="16sp" />

        <Button android:id="@+id/aTap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Input: tap centre (640 400)" />
        <Button android:id="@+id/aSwipe" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Input: swipe left" />
        <Button android:id="@+id/aBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Back" />
        <Button android:id="@+id/aSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start Settings" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <EditText android:id="@+id/textField" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="text to type" android:textSize="16sp" />
            <Button android:id="@+id/aText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Input: text" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <EditText android:id="@+id/cmdField" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="free-form shell command" android:textSize="16sp" />
            <Button android:id="@+id/cmdRun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Run" />
        </LinearLayout>

        <TextView android:id="@+id/out" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:typeface="monospace" android:textSize="13sp"
            android:paddingTop="12dp" />
    </LinearLayout>
</ScrollView>
